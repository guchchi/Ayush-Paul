# ==============================================================================
# Blueprint OS — Environment Configuration Template (.env.example)
#
# IMPORTANT SECURITY NOTE:
# - Variables prefixed with "VITE_" are embedded into client-side bundles by Vite
#   and ARE EXPOSED TO THE BROWSER. Never put private production secrets here.
# - Non-VITE variables are strictly server-side (Node.js / Express / Vercel API).
# - Copy this file to .env or .env.local for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# App & Deployment Configuration
# ------------------------------------------------------------------------------
# APP_URL: [Required - Server & Local] Base URL for redirection, checkout callbacks, and canonical links.
APP_URL=http://localhost:3000

# VERCEL_DEPLOY_HOOK_URL: [Optional - Server Secret] Webhook to trigger auto-rebuild after publishing content.
VERCEL_DEPLOY_HOOK_URL=

# ------------------------------------------------------------------------------
# Firebase Client Configuration (Browser / Public)
# (Public client identifiers used to initialize the Firebase Web SDK)
# ------------------------------------------------------------------------------
# VITE_FIREBASE_API_KEY: [Required - Public Client] Firebase Web API Key.
VITE_FIREBASE_API_KEY=

# VITE_FIREBASE_AUTH_DOMAIN: [Required - Public Client] Firebase Auth domain.
VITE_FIREBASE_AUTH_DOMAIN=

# VITE_FIREBASE_PROJECT_ID: [Required - Public Client] Google Cloud / Firebase Project ID.
VITE_FIREBASE_PROJECT_ID=

# VITE_FIREBASE_STORAGE_BUCKET: [Required - Public Client] Cloud Storage bucket URI.
VITE_FIREBASE_STORAGE_BUCKET=

# VITE_FIREBASE_MESSAGING_SENDER_ID: [Required - Public Client] FCM Sender ID.
VITE_FIREBASE_MESSAGING_SENDER_ID=

# VITE_FIREBASE_APP_ID: [Required - Public Client] Firebase App ID.
VITE_FIREBASE_APP_ID=

# VITE_FIREBASE_FIRESTORE_DB_ID: [Optional - Public Client] Named Firestore database identifier.
VITE_FIREBASE_FIRESTORE_DB_ID=

# ------------------------------------------------------------------------------
# Firebase Admin Configuration (Server-Only Secret)
# ------------------------------------------------------------------------------
# FIREBASE_SERVICE_ACCOUNT: [Required for Admin/Server API - Server Secret]
# Serialized JSON string of the Firebase Admin service account key.
# Alternatively, place service-account.json in the repository root (automatically gitignored).
FIREBASE_SERVICE_ACCOUNT=

# ------------------------------------------------------------------------------
# Stripe Payments Configuration
# ------------------------------------------------------------------------------
# STRIPE_SECRET_KEY: [Required for Payments - Server Secret] Stripe Secret API Key (e.g. sk_test_...).
STRIPE_SECRET_KEY=

# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY: [Optional/Public] Stripe Publishable Key (pk_test_...).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# STRIPE_WEBHOOK_SECRET: [Required for Webhooks - Server Secret] Stripe Webhook Signing Secret (whsec_...).
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Email Service Configuration (Resend)
# ------------------------------------------------------------------------------
# RESEND_API_KEY: [Required for Transactional Email - Server Secret] Resend API Key (re_...).
RESEND_API_KEY=

# ------------------------------------------------------------------------------
# Google Generative AI (Gemini) Configuration
# ------------------------------------------------------------------------------
# GOOGLE_API_KEY: [Required for AI Server Endpoints - Server Secret] Google AI Studio Gemini API Key.
GOOGLE_API_KEY=

# VITE_GOOGLE_API_KEY: [Optional - Public Client Warning]
# WARNING: Exposes key in browser bundle. Use only for local dev/mock or restricted demo keys.
VITE_GOOGLE_API_KEY=

# VITE_GEMINI_API_KEY: [Optional - Public Client Warning]
# WARNING: Exposes key in browser bundle. Use only for local dev/mock or restricted demo keys.
VITE_GEMINI_API_KEY=

# VITE_GEMINI_MODEL: [Optional - Public Client] Gemini model override (e.g. gemini-1.5-flash).
VITE_GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Internal Security & Service Access Keys (Server Secrets)
# ------------------------------------------------------------------------------
# PUBLISH_API_KEY: [Required for CMS publishing API - Server Secret] Bearer token for /api/publish.
PUBLISH_API_KEY=

# INTERNAL_API_KEY: [Optional - Server Secret] Secret key for cron jobs & automated background tasks.
INTERNAL_API_KEY=

# EMAIL_SERVICE_KEY: [Optional - Server Secret] Key for background email dispatch endpoints.
EMAIL_SERVICE_KEY=

# DEBUG_API_KEY: [Optional - Server Secret] Key required to access non-production debug endpoints.
DEBUG_API_KEY=

# ------------------------------------------------------------------------------
# Administrative Access Controls
# ------------------------------------------------------------------------------
# ADMIN_EMAIL: [Optional - Server] Primary admin email for notifications and access verification.
ADMIN_EMAIL=admin@example.com

# ADMIN_EMAIL_ALLOWLIST: [Optional - Server] Comma-separated list of authorized administrator emails.
ADMIN_EMAIL_ALLOWLIST=admin1@example.com,admin2@example.com

# ADMIN_UIDS: [Optional - Server] Comma-separated list of authorized Firebase UIDs.
ADMIN_UIDS=

# VITE_ADMIN_UIDS: [Optional - Public Client UI gate] Comma-separated list of admin UIDs for client routing.
VITE_ADMIN_UIDS=

# VITE_ADMIN_EMAILS: [Optional - Public Client UI gate] Comma-separated list of admin emails for client routing.
VITE_ADMIN_EMAILS=

# ------------------------------------------------------------------------------
# Analytics & Feature Flags (Optional Public Client)
# ------------------------------------------------------------------------------
# VITE_POSTHOG_KEY: [Optional - Public Client] PostHog project API key.
VITE_POSTHOG_KEY=

# VITE_POSTHOG_HOST: [Optional - Public Client] PostHog host URL (e.g. https://us.i.posthog.com).
VITE_POSTHOG_HOST=https://us.i.posthog.com

# VITE_FEATURE_FLAG_SOCIAL_PROOF: [Optional - Public Client] Toggle live purchase notifications (true/false).
VITE_FEATURE_FLAG_SOCIAL_PROOF=false
