rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // REUSABLE HELPER FUNCTIONS
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      // Bootstrap fallback: hardcoded UID of initial admin.
      // Once the seed script creates admin_users/{uid}, this hardcoded
      // check can be removed.
      return isAuthenticated() && (
        request.auth.uid == "80OJfcmVXCRNmSZuthVU68K6vJq2" ||
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }


    // ============================================================
    // DEFAULT DENY — catches every collection not explicitly listed
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }


    // ============================================================
    // PUBLIC READ, ADMIN WRITE — Content Collections
    // Public-facing content that anyone can browse.
    // Writes restricted to admin via CMS or server-side API.
    // ============================================================

    match /blogPosts/{docId} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.data.keys().hasAll(['title', 'slug', 'content', 'published'])
                   && request.resource.data.title is string
                   && request.resource.data.content is string
                   && !(request.resource.data.title.lower().matches('.*test.*'))
                   && !(request.resource.data.content.lower().matches('.*test.*'));
    }

    match /projects/{docId} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.data.keys().hasAll(['title', 'description', 'status'])
                   && request.resource.data.title is string
                   && !(request.resource.data.title.lower().matches('.*test.*'));
    }

    match /updates/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /product_assets/{productId} {
      allow read, write: if isAdmin();
    }

    match /courses/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /modules/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /lessons/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /workshops/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }


    // ============================================================
    // PUBLIC CREATE, ADMIN READ — User Submissions
    // Public visitors submit data (contact forms, newsletter signups,
    // workshop registrations, etc). Read and manage restricted to admin.
    // ============================================================

    match /contact_messages/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /collaboration_requests/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /subscribers/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /analytics_events/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /mentorship_applications/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /contacts/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /newsletter/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }


    // ============================================================
    // AUTH-OWNED — User Identity, Enrollments, Purchases
    // Authenticated users read their own data; admin full access.
    // ============================================================

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /enrollments/{docId} {
      allow read, write: if (
        resource == null || resource.data.userId == request.auth.uid
      ) && (
        request.resource == null || request.resource.data.userId == request.auth.uid
      ) || isAdmin();
    }

    match /purchases/{docId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /workshop_registrations/{docId} {
      allow create: if true;
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }


    // ============================================================
    // PUBLIC READ, ADMIN WRITE — Social Proof
    // Public_purchases displays recent purchase notifications site-wide.
    // Only non-sensitive fields are exposed (product name, timestamp).
    // ============================================================

    match /public_purchases/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }


    // ============================================================
    // ADMIN ONLY — CMS-Managed Collections
    // Displayed and managed exclusively via the admin dashboard.
    // No public or authenticated-user access.
    // ============================================================

    match /creator_codes/{docId} {
      allow read, write: if isAdmin();
    }

    match /creator_sales_log/{docId} {
      allow read, write: if isAdmin();
    }

    match /coupons/{docId} {
      allow read, write: if isAdmin();
    }

    match /scheduled_emails/{docId} {
      allow read, write: if isAdmin();
    }

    match /share_events/{docId} {
      allow read, write: if isAdmin();
    }

    match /streak_milestones/{docId} {
      allow read, write: if isAdmin();
    }

    match /newsletter_campaigns/{docId} {
      allow read, write: if isAdmin();
    }

    match /referrals/{docId} {
      allow read, write: if isAdmin();
    }

    match /user_unlocks/{docId} {
      allow read, write: if isAdmin();
    }

    match /blueprints/{docId} {
      allow read, write: if isAdmin();
    }

    match /test_connection/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
