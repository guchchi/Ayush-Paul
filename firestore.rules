rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ["80OJfcmVXCRNmSZuthVU68K6vJq2"];
    }

    match /projects/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blogPosts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /contacts/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    match /newsletter/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    match /test_connection/{id} {
      allow create: if isAdmin();
      allow read, update, delete: if isAdmin();
    }

    match /content/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
