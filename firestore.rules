rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Publicly readable endpoints with strict schema enforcement on write
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if request.auth != null 
                   && request.resource.data.keys().hasAll(['title', 'slug', 'content', 'published'])
                   && request.resource.data.title is string
                   && request.resource.data.content is string
                   && !(request.resource.data.title.lower().matches('.*test.*'))
                   && !(request.resource.data.content.lower().matches('.*test.*'));
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.data.keys().hasAll(['title', 'description', 'status'])
                   && request.resource.data.title is string
                   && !(request.resource.data.title.lower().matches('.*test.*'));
    }

    match /updates/{updateId} {
      allow read: if true;
      allow write: if request.auth != null; // Basic auth check for admin writes
    }
  }
}
