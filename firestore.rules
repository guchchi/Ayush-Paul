rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ["80OJfcmVXCRNmSZuthVU68K6vJq2"];
    }

    match /projects/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blogPosts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /updates/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /content/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /contacts/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    match /newsletter/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    match /test_connection/{id} {
      allow create: if isAdmin();
      allow read, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }

    match /purchases/{id} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /public_purchases/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subscribers/{id} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    match /analytics_events/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /collaboration_requests/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /contact_messages/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /newsletter_campaigns/{id} {
      allow read, write: if isAdmin();
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
